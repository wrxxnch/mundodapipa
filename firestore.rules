rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog: public read & write for app management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Users collection: public read & write for app user profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Carts collection: allow read & write for user cart sync
    match /carts/{userId} {
      allow read, write: if true;
    }
  }
}
